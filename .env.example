# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Payment Providers (Paystack & Flutterwave)
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"
PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"
FLW_SECRET_KEY="FLWSECK_TEST-your_flutterwave_secret_key"
FLW_SECRET_HASH="your_flutterwave_webhook_secret_hash"
FLW_PUBLIC_KEY="FLWPUBK_TEST-your_flutterwave_public_key"

# WhatsApp Automation Providers (Meta Cloud API & Termii)
META_WHATSAPP_ACCESS_TOKEN="your_meta_whatsapp_access_token"
META_WHATSAPP_PHONE_NUMBER_ID="your_meta_phone_number_id"
META_WHATSAPP_BUSINESS_ACCOUNT_ID="your_meta_waba_id"
TERMII_API_KEY="your_termii_api_key"
TERMII_DEVICE_ID="your_termii_device_id"

